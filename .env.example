# Runtime da API
NODE_ENV=development
PORT=
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info

# Banco e filas
# DATABASE_URL e REDIS_URL são as únicas URLs canônicas lidas pela aplicação.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tmxhub
REDIS_URL=redis://localhost:6379

# Segredos da API
# REQUIRED_IN_PRODUCTION: gere valores aleatórios; nunca reutilize os exemplos.
JWT_SECRET=replace-with-at-least-32-random-characters
TRACKING_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
WEBHOOK_SECRET=replace-with-a-random-webhook-signing-secret
# Janela de rotação: remova depois que todos os tokens/assinaturas antigos expirarem.
WEBHOOK_SECRET_PREV=
WEBHOOK_SIGNATURE_REQUIRED=false

# Webhooks de pagamento
EXPLODELY_REQUIRE_SIGNATURE=true
EXPLODELY_WEBHOOK_SECRET=replace-with-the-provider-webhook-secret
WEBHOOK_PAYLOAD_SCRUB=false

# Bootstrap e acesso
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ALLOW_REGISTRATION=false

# URLs públicas
PUBLIC_BASE_URL=http://localhost:4000
TRACKING_PUBLIC_BASE_URL=https://theminex.com

# Integração YouTube Rewards
YOUTUBE_REWARDS_WEBHOOK_URL=
YOUTUBE_REWARDS_WEBHOOK_SECRET=
YOUTUBE_REWARDS_SITE_BYPASS_TOKEN=

# Google Ads OAuth
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_OAUTH_REDIRECT_URI=http://localhost:4000/v1/tracking/google-ads/oauth/callback
META_GRAPH_API_VERSION=v25.0

# AssemblyAI (opcional; sem a chave a verificação de transcrição é ignorada)
ASSEMBLYAI_API_KEY=

# S3-compatible storage (MinIO em desenvolvimento)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clones
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Render e browser
MAX_RENDER_TIMEOUT_MS=90000
MAX_ASSET_BYTES=26214400
MAX_TOTAL_BYTES=262144000
BROWSER_POOL_SIZE=3
PLAYWRIGHT_BROWSERS_PATH=

# Railway GraphQL/custom domains
# RAILWAY_PROJECT_TOKEN: apenas pra deploy. NÃO deve ser lido em runtime.
RAILWAY_PROJECT_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_API_SERVICE_ID=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PROXY_TARGET=http://localhost:4000
NEXT_DIST_DIR=

# Script manual packages/api/scripts/import-pjr-eng.mjs (não usado no runtime da API)
LOCAL_DATABASE_URL=
LOCAL_REDIS_URL=
PROD_DATABASE_URL=
PROD_REDIS_URL=

# Script de retenção packages/api/scripts/purge-old-events.mjs
TRACKING_EVENTS_RETENTION_DAYS=180

# Variáveis injetadas automaticamente pelo Railway (não definir manualmente).
# DATABASE_URL acima continua canônica; DATABASE_PUBLIC_URL, PG* e POSTGRES_* são aliases.
# DATABASE_PUBLIC_URL=<injetado pelo Railway>
# PGDATA=<injetado pelo Railway>
# PGDATABASE=<alias Railway de DATABASE_URL>
# PGHOST=<alias Railway de DATABASE_URL>
# PGPASSWORD=<alias Railway de DATABASE_URL>
# PGPORT=<alias Railway de DATABASE_URL>
# PGUSER=<alias Railway de DATABASE_URL>
# POSTGRES_DB=<alias Railway de DATABASE_URL>
# POSTGRES_PASSWORD=<alias Railway de DATABASE_URL>
# POSTGRES_USER=<alias Railway de DATABASE_URL>

# REDIS_URL acima continua canônica; REDIS_*, REDIS* e REDIS_PUBLIC_URL são aliases.
# REDISHOST=<alias Railway de REDIS_URL>
# REDISPASSWORD=<alias Railway de REDIS_URL>
# REDISPORT=<alias Railway de REDIS_URL>
# REDISUSER=<alias Railway de REDIS_URL>
# REDIS_PASSWORD=<alias Railway de REDIS_URL>
# REDIS_PUBLIC_URL=<injetado pelo Railway>

# Metadados de plataforma Railway, disponíveis sem configuração manual.
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS=<injetado pelo Railway>
# RAILWAY_ENVIRONMENT=<injetado pelo Railway>
# RAILWAY_ENVIRONMENT_NAME=<injetado pelo Railway>
# RAILWAY_PRIVATE_DOMAIN=<injetado pelo Railway>
# RAILWAY_PROJECT_NAME=<injetado pelo Railway>
# RAILWAY_PUBLIC_DOMAIN=<injetado pelo Railway>
# RAILWAY_SERVICE_ID=<injetado pelo Railway; não substitui RAILWAY_API_SERVICE_ID>
# RAILWAY_SERVICE_NAME=<injetado pelo Railway>
# RAILWAY_SERVICE__PAGE_CLONER_API_URL=<injetado pelo Railway>
# RAILWAY_SERVICE__PAGE_CLONER_WEB_URL=<injetado pelo Railway>
# RAILWAY_STATIC_URL=<injetado pelo Railway>
# RAILWAY_TCP_APPLICATION_PORT=<injetado pelo Railway>
# RAILWAY_TCP_PROXY_DOMAIN=<injetado pelo Railway>
# RAILWAY_TCP_PROXY_PORT=<injetado pelo Railway>
# RAILWAY_VOLUME_ID=<injetado pelo Railway>
# RAILWAY_VOLUME_MOUNT_PATH=<injetado pelo Railway>
# RAILWAY_VOLUME_NAME=<injetado pelo Railway>
# SSL_CERT_DAYS=<injetado pelo Railway>
