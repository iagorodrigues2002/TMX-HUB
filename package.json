{
  "name": "page-cloner",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm --filter @page-cloner/core build && pnpm -r test",
    "typecheck": "pnpm --filter @page-cloner/core build && pnpm -r typecheck",
    "lint": "biome check .",
    "lint:quality": "eslint -c eslint.quality.config.mjs packages/*/src",
    "lint:typed": "eslint -c eslint.typed.config.mjs packages/*/src",
    "test:quality-rules": "node scripts/verify-quality-rules.mjs ./eslint-rules/index.cjs",
    "check": "pnpm lint && pnpm lint:quality && pnpm lint:typed && pnpm typecheck && pnpm test:quality-rules && pnpm test && pnpm build",
    "format": "biome format --write .",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "pnpm": {
    "overrides": {
      "fastify@>=5.0.0 <5.12.2": "5.12.2",
      "find-my-way@>=9.0.0 <9.7.0": "9.7.0",
      "fast-uri@>=3.0.0 <3.1.7": "3.1.7",
      "@fastify/static@>=9.0.0 <10.1.1": "10.1.1",
      "@fastify/busboy@>=3.0.0 <3.2.1": "3.2.1",
      "fast-xml-builder@>=1.0.0 <1.1.7": "1.1.7",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "eslint": "10.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^2.1.6"
  }
}
